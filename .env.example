# Frontend: leave unset for demo (localStorage) mode.
# Set to your API base to use the real backend. In dev the Vite proxy forwards /api to :4000.
VITE_API_URL=/api

# Backend (server/index.js) - set these in your host's environment, NOT in the frontend:
# PORT=4000
# JWT_SECRET=change-me-to-a-long-random-string
# CLIENT_ORIGIN=https://your-site.com
